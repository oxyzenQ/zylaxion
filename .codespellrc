[codespell]
skip = .git,target,Cargo.lock,./assets
quiet-level = 3
# fpr: the OpenPGP fingerprint abbreviation the commit-signature
# lane's stamp grammar rides (verified:<fpr>, the zelynic estate's
# codespell config ignores the same token).
ignore-words-list = rezky,nightky,oxyzenq,zylaxion,zactrix,procfs,symlink,symlinks,rustfmt,clippy,uptodate,nd,retuned,fpr
