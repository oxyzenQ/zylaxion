#
# systemd SYSTEM path unit for zylaxion's pin hand-over
# (night-dinner-19). The boot oneshot (zylaxion-attach.service) runs
# BEFORE anyone logs in, so the pins it plants are root-owned; this
# watch fires when the first desktop runtime directory appears under
# /run/user (systemd-logind creates it at the user's first login) and
# starts zylaxion-handover.service, whose `zylaxion attach` hands the
# pins to that desktop user and relaxes the bpffs front door by the
# one missing bit. Zero-touch: boot, log in, `zylaxion on` — no
# manual attach in between.
#
# The glob speaks the same uid law as the attach's recipient filter
# (uid >= 1000, night-last-total-lts-6): a greeter or service runtime
# directory (system uid range, e.g. /run/user/120 on GDM hosts) must
# NOT fire this watch — the attach would find no desktop recipient,
# and with RemainAfterExit=yes the spent start keeps the unit active
# so the REAL login's trigger becomes a no-op, leaving the pins
# root-owned. Four-plus digits starting 1-9 never match the system
# uid range and always match the desktop range.
#
# Install to:
#   /etc/systemd/system/zylaxion-handover.path
#
# Enable (together with the service unit, done by
# scripts/package/install.sh and install-on-my-machine.sh):
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zylaxion-handover.path

[Unit]
Description=zylaxion pin hand-over trigger (the first desktop /run/user entry)
Documentation=https://github.com/oxyzenQ/zylaxion

[Path]
PathExistsGlob=/run/user/[1-9][0-9][0-9][0-9]*
Unit=zylaxion-handover.service

[Install]
WantedBy=multi-user.target
